# Variáveis de Ambiente - Staging
# Copie este arquivo para .env.staging e preencha com suas credenciais

# ============================================
# SUPABASE (Staging)
# ============================================
VITE_SUPABASE_URL=https://[SEU-PROJETO-STAGING].supabase.co
VITE_SUPABASE_ANON_KEY=[SUA-CHAVE-ANON-STAGING]

# ============================================
# GEMINI AI
# ============================================
VITE_GEMINI_API_KEY=[SUA-CHAVE-GEMINI]

# ============================================
# CONFIGURAÇÕES DO APP
# ============================================
VITE_ENV=staging
VITE_APP_VERSION=3.0.0-staging
VITE_APP_NAME=ExamePad Staging

# ============================================
# FEATURE FLAGS (Staging)
# ============================================
VITE_ENABLE_AI_TUTOR=true
VITE_ENABLE_GAMIFICATION=true
VITE_ENABLE_RISK_DETECTION=true
VITE_ENABLE_OCR=true
VITE_ENABLE_TABLET_MODE=true
VITE_ENABLE_LIVE_MONITOR=true

# ============================================
# DEBUG & LOGGING
# ============================================
VITE_DEBUG_MODE=true
VITE_LOG_LEVEL=debug

# ============================================
# SENTRY (Opcional - para monitoramento)
# ============================================
# VITE_SENTRY_DSN=[SEU-DSN-SENTRY]
# VITE_SENTRY_ENVIRONMENT=staging

# ============================================
# ANALYTICS (Opcional)
# ============================================
# VITE_GA_TRACKING_ID=[SEU-GA-ID]

# ============================================
# NOTAS
# ============================================
# 1. NÃO commite este arquivo com credenciais reais
# 2. Use .env.staging.example como template
# 3. Mantenha as chaves seguras
# 4. Rotacione chaves periodicamente
